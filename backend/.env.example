# Copy this file to .env in the backend folder. Keep provider secrets on the server.
PORT=3001
# Local default: http://localhost:5173. In production, use the deployed frontend origin.
APP_ORIGIN=http://localhost:5173
# Leave empty for local Vite proxy. For a separately hosted frontend, set the public API origin.
API_ORIGIN=
# Select "official", "third-party" or "mock". Mock is rejected in production.
PROFILE_PROVIDER=official

# TikTok Login Kit (users authorize their own accounts; arbitrary profile lookup is unavailable).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://your-api.example/api/oauth/tiktok/callback

# Meta Business Discovery (Facebook Login, lets an authorized connected IG professional account
# query eligible public Business/Creator profiles; still subject to Meta app review/permissions).
INSTAGRAM_API_MODE=business-discovery
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://your-api.example/api/oauth/instagram/callback
META_GRAPH_API_VERSION=

# Optional direct Instagram Login mode for the account owner only.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://your-api.example/api/oauth/instagram/callback
INSTAGRAM_GRAPH_API_VERSION=

# Optional provider endpoint. The configured service must permit this use and return the documented schema.
CREATOR_DATA_PROVIDER_URL=
CREATOR_DATA_PROVIDER_TOKEN=

# Supabase Auth: keep the same project URL and publishable/anon key configured in frontend/.env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
